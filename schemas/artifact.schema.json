{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact",
  "type": "object",
  "required": [
    "format",
    "architecture",
    "files"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "architecture": {
      "type": "object",
      "required": [
        "base_repository",
        "base_revision",
        "lora"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "size",
          "sha256"
        ]
      }
    }
  },
  "additionalProperties": true
}
